<?xml version="1.0"?>
<!--
  swebot (explore_bot package) - differential drive robot for Gazebo Sim (gz-sim) + ROS 2

  Frame convention (REP-103):  +x forward, +y left, +z up.
    base_link = on the floor, directly below the midpoint of the drive-wheel axle.
    Forward (+x) is the CASTER end of the robot.

  Same meshes as the CAD export (package://explore_bot/meshes/...), with these changes:
    1. base_link moved to the axle midpoint (required for correct odometry).
    2. Realistic masses/inertias (the CAD export had ~0.01 kg for the whole body).
    3. Simple primitive collision shapes instead of STL collisions.
    4. Joints renamed so the DiffDrive plugin config is readable.
    5. Added: lidar_link, imu_link, and the Gazebo plugins/sensors (bottom of file).
-->
<robot name="swebot">

  <!-- ================= BASE ================= -->
  <link name="base_link" />

  <!-- Body mesh frame is rotated +90 deg about z relative to base_link, and shifted
       so the wheel-axle midpoint lands exactly on base_link's origin. -->
  <joint name="base_to_body" type="fixed">
    <origin xyz="0.323981 0 0.146" rpy="0 0 1.5708" />
    <parent link="base_link" />
    <child link="body" />
  </joint>

  <link name="body">
    <inertial>
      <mass value="2.0" />
      <origin xyz="0 0.234 0" rpy="0 0 0" />
      <!-- solid box 0.22 x 0.42 x 0.15 m -->
      <inertia ixx="0.03315" ixy="0" ixz="0" iyy="0.011817" iyz="0" izz="0.037467" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://explore_bot/meshes/body.stl" scale="1 1 1" />
      </geometry>
      <material name="body_blue">
        <color rgba="0.615686 0.811765 0.929412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.234 0" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.42 0.15" />
      </geometry>
    </collision>
  </link>

  <!-- ================= DRIVE WHEELS =================
       Wheel: radius 0.10 m, width 0.05 m, axis = body x (= base_link y).
       Joint frame is at the wheel CENTER; visual offset undoes that so the
       original STL lands where it was in the CAD model.
       Wheel separation (center to center) = 0.27 m. -->
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0.135 0.323981 -0.0460411" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <parent link="body" />
    <child link="left_wheel" />
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="0.15" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="7.5e-4" ixy="0" ixz="0" iyy="4.0625e-4" iyz="0" izz="4.0625e-4" />
    </inertial>
    <visual>
      <origin xyz="-0.135 -0.323981 0.0460411" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://explore_bot/meshes/left_wheel.stl" scale="1 1 1" />
      </geometry>
      <material name="wheel_grey">
        <color rgba="0.647059 0.647059 0.647059 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.135 0.323981 -0.0460411" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <parent link="body" />
    <child link="right_wheel" />
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="0.15" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="7.5e-4" ixy="0" ixz="0" iyy="4.0625e-4" iyz="0" izz="4.0625e-4" />
    </inertial>
    <visual>
      <origin xyz="0.135 -0.323981 0.0460411" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://explore_bot/meshes/right_wheel.stl" scale="1 1 1" />
      </geometry>
      <material name="wheel_blue">
        <color rgba="0.231373 0.380392 0.705882 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.1" length="0.05" />
      </geometry>
    </collision>
  </link>

  <!-- ================= CASTER (swivel + wheel) ================= -->
  <joint name="caster_swivel_joint" type="continuous">
    <origin xyz="0 0.0557349 -0.0335411" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <parent link="body" />
    <child link="caster_body" />
  </joint>

  <link name="caster_body">
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 -0.0141 -0.0421" rpy="0 0 0" />
      <inertia ixx="5.475e-5" ixy="0" ixz="0" iyy="3.98e-5" iyz="0" izz="3.58e-5" />
    </inertial>
    <visual>
      <origin xyz="0 -0.0557349 0.0335411" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://explore_bot/meshes/caster_body.stl" scale="1 1 1" />
      </geometry>
      <material name="caster_orange">
        <color rgba="0.972549 0.529412 0.00392157 1" />
      </material>
    </visual>
    <!-- no collision: it never touches the ground -->
  </link>

  <joint name="caster_wheel_joint" type="continuous">
    <origin xyz="0 -0.0317543 -0.0625" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <parent link="caster_body" />
    <child link="caster_wheel" />
  </joint>

  <link name="caster_wheel">
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="6.25e-5" ixy="0" ixz="0" iyy="3.39e-5" iyz="0" izz="3.39e-5" />
    </inertial>
    <visual>
      <origin xyz="0 -0.0239806 0.0960411" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://explore_bot/meshes/caster_wheel.stl" scale="1 1 1" />
      </geometry>
      <material name="caster_light">
        <color rgba="0.768627 0.886275 0.952941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
  </link>

  <!-- ================= SENSOR LINKS =================
       Lidar height: 0.23 m above the floor. This is ABOVE the body top (0.22 m) so the
       chassis never blocks the beams, and BELOW the shortest obstacles in the arena
       (0.25 m) so every obstacle is detected. Raising it above ~0.24 m would make
       the lidar miss the shortest cylinders/blocks/trapezoid. -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.09 0 0.23" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="5.1e-5" ixy="0" ixz="0" iyy="5.1e-5" iyz="0" izz="6.1e-5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.04" />
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <!-- ================= GAZEBO: friction ================= -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <!-- caster should slide freely, not drag -->
  <gazebo reference="caster_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- ================= GAZEBO: model plugins ================= -->
  <gazebo>
    <!-- Wheel odometry + cmd_vel. Publishes odom -> base_link on /tf and /odom. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.27</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>

    <!-- Wheel/caster joint angles, so robot_state_publisher can move the wheels in TF/RViz.
         Needs /joint_states added to the ros_gz_bridge list in launch.py. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ================= GAZEBO: lidar ================= -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= GAZEBO: IMU ================= -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
