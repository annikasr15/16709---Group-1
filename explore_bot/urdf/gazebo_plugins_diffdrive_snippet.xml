<!--
  Assignment 3, Task 4 — paste this whole block into your
  mobile_manipulator_template.urdf (after you've done the ARM SPLICE),
  just before the closing </robot> tag. Same "escape hatch" pattern as
  the arm's earlier JointPositionController `<gazebo>` snippet.

  Block 1: DiffDrive — turns /cmd_vel Twist commands into wheel motion and
  publishes odometry + the odom->base_link TF. This is the whole mobile
  base's motor controller.
  Block 2: JointStatePublisher — publishes wheel (and, once you've done
  the arm splice, arm joint) angles, same escape-hatch pattern used earlier in this assignment.
  Block 3: the lidar's actual <sensor> definition — the lidar_link you
  already have is just its mechanical mount; this is what makes it
  produce a real /scan.

  Do not rename left_wheel_joint / right_wheel_joint / lidar_link — they
  must match the names already in your URDF.
-->
<gazebo>
  <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.34</wheel_separation>
    <wheel_radius>0.05</wheel_radius>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <odom_publish_frequency>30</odom_publish_frequency>
    <tf_topic>/tf</tf_topic>
    <max_linear_acceleration>1.0</max_linear_acceleration>
    <min_linear_acceleration>-1.0</min_linear_acceleration>
    <max_angular_acceleration>2.0</max_angular_acceleration>
    <min_angular_acceleration>-2.0</min_angular_acceleration>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher"/>
</gazebo>

<gazebo reference="lidar_link">
  <sensor name="lidar" type="gpu_lidar">
    <topic>scan</topic>
    <update_rate>10</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <gz_frame_id>lidar_link</gz_frame_id>
    <lidar>
      <!-- 320 deg, not a full 360. The arm you splice on stands at the
           chassis centre, 0.13 m directly behind this lidar, so a
           full-circle scan sees the arm itself: returns that land inside
           the robot's own footprint, which Nav2's collision_monitor reads
           as a permanent imminent collision. Blanking the rear arc is the
           normal fix for a sensor that can see part of its own robot. -->
      <scan>
        <horizontal>
          <samples>320</samples>
          <resolution>1</resolution>
          <min_angle>-2.79253</min_angle>
          <max_angle>2.79253</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.10</min>
        <max>8.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>
