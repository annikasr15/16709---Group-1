<?xml version="1.0" ?>
<!--
  This is the final project arena. A 9x9 m bounded room with static obstacles.

  Launch with:
    gz sim -r arena_final_project.sdf
  or headless:
    gz sim -s -r arena_final_project.sdf
-->
<sdf version="1.6">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>9 9</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>9 9</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter walls: 9x9 m room, walls centered on x=+/-4.5, y=+/-4.5 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.1 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.1 0.1 0.5</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.1 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.1 0.1 0.5</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 9.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 9.1 0.5</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 9.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 9.1 0.5</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--OBSTACLES-->

    <model name="cylinder_a">
      <static>true</static>
      <pose>-2 2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.74 0.04 0.53 1</ambient><diffuse>0.74 0.04 0.53 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_b">
      <static>true</static>
      <pose>3 -2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.74 0.04 0.53 1</ambient><diffuse>0.74 0.04 0.53 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_c">
      <static>true</static>
      <pose>1 3.5 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.25</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.74 0.04 0.53 1</ambient><diffuse>0.74 0.04 0.53 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_d">
      <static>true</static>
      <pose>0 -1 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.35</length></cylinder></geometry>
          <material><ambient>0.74 0.04 0.53 1</ambient><diffuse>0.74 0.04 0.53 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_e">
      <static>true</static>
      <pose>-1.2 -3.0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.175</radius><length>0.45</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.175</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.74 0.04 0.53 1</ambient><diffuse>0.74 0.04 0.53 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_a">
      <static>true</static>
      <pose>-2.5 -1.0 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.3 0.35</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.3 0.35</size></box></geometry>
          <material><ambient>0.04 0.15 0.75 1</ambient><diffuse>0.04 0.15 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_b">
      <static>true</static>
      <pose>0.5 -2.5 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.45</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.45</size></box></geometry>
          <material><ambient>0.04 0.15 0.75 1</ambient><diffuse>0.04 0.15 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_c">
      <static>true</static>
      <pose>2.5 1.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.9 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.9 0.3</size></box></geometry>
          <material><ambient>0.04 0.15 0.75 1</ambient><diffuse>0.04 0.15 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_d">
      <static>true</static>
      <pose>-0.5 1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.4 0.4</size></box></geometry>
          <material><ambient>0.04 0.15 0.75 1</ambient><diffuse>0.04 0.15 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_e">
      <static>true</static>
      <pose>-3.2 -3.2 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.25</size></box></geometry>
          <material><ambient>0.04 0.15 0.75 1</ambient><diffuse>0.04 0.15 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trapezoid_a">
      <static>true</static>
      <pose>3.2 3.25 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><polyline>
          <point>-0.4 0</point><point>0.4 0</point><point>0.2 0.35</point><point>-0.2 0.35</point>
          <height>0.5</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline>
          <point>-0.4 0</point><point>0.4 0</point><point>0.2 0.35</point><point>-0.2 0.35</point>
          <height>0.5</height></polyline></geometry>
          <material><ambient>0.04 0.44 0.12 1</ambient><diffuse>0.04 0.44 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trapezoid_b">
      <static>true</static>
      <pose>-3.2 3.4 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><polyline>
          <point>-0.3 0</point><point>0.3 0</point><point>0.15 0.45</point><point>-0.15 0.45</point>
          <height>0.4</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline>
          <point>-0.3 0</point><point>0.3 0</point><point>0.15 0.45</point><point>-0.15 0.45</point>
          <height>0.4</height></polyline></geometry>
          <material><ambient>0.04 0.44 0.12 1</ambient><diffuse>0.04 0.44 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trapezoid_c">
      <static>true</static>
      <pose>-3.5 0.95 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><polyline>
          <point>-0.25 0</point><point>0.25 0</point><point>0.15 0.3</point><point>-0.15 0.3</point>
          <height>0.7</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline>
          <point>-0.25 0</point><point>0.25 0</point><point>0.15 0.3</point><point>-0.15 0.3</point>
          <height>0.7</height></polyline></geometry>
          <material><ambient>0.04 0.44 0.12 1</ambient><diffuse>0.04 0.44 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trapezoid_d">
      <static>true</static>
      <pose>2.3 -3.2 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><polyline>
          <point>-0.45 0</point><point>0.45 0</point><point>0.25 0.25</point><point>-0.25 0.25</point>
          <height>0.4</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline>
          <point>-0.45 0</point><point>0.45 0</point><point>0.25 0.25</point><point>-0.25 0.25</point>
          <height>0.4</height></polyline></geometry>
          <material><ambient>0.04 0.44 0.12 1</ambient><diffuse>0.04 0.44 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trapezoid_e">
      <static>true</static>
      <pose>-1.0 3.75 0 1.5708 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><polyline>
          <point>-0.35 0</point><point>0.35 0</point><point>0.15 0.4</point><point>-0.15 0.4</point>
          <height>0.3</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline>
          <point>-0.35 0</point><point>0.35 0</point><point>0.15 0.4</point><point>-0.15 0.4</point>
          <height>0.3</height></polyline></geometry>
          <material><ambient>0.04 0.44 0.12 1</ambient><diffuse>0.04 0.44 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>